# ignore python cache
__pycache__/
*.pyc

# ignore sensitive dataset with big files
*.dcm
*.nii
*.nii.gz
PANCREAS_2/
data/

# ignore env config
.vscode/
.DS_Store

# ignore generated analysis reports with sensitive data
analysis/reports/
.ipynb_checkpoints/

# ignore local archive backups (keep locally, never commit)
*.zip
*.ZIP

# ignore LaTeX build artifacts
thesis/*.aux
thesis/*.bbl
thesis/*.blg
thesis/*.fdb_latexmk
thesis/*.fls
thesis/*.lof
thesis/*.log
thesis/*.lot
thesis/*.out
thesis/*.toc
thesis/*.synctex.gz
thesis/MasterThesis.pdf